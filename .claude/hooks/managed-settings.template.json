{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__GUARD__"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
