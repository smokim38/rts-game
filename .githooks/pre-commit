#!/bin/sh
# Blocks the commit if gitleaks finds a secret in the staged changes.
# Fails closed: no gitleaks, no commit.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so this commit is blocked." >&2
  echo "Install gitleaks v8 (https://github.com/gitleaks/gitleaks), then commit again." >&2
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner; then
  echo "pre-commit: gitleaks reported a possible secret (or failed to run). Commit blocked." >&2
  echo "Remove the secret and commit again. If you think it's a false positive, stop and tell the owner." >&2
  exit 1
fi
