#!/bin/sh
# Blocks the commit if gitleaks finds a secret in the staged files.
# Also run by pre-merge-commit, so merge commits are scanned too.
# Fails closed: no gitleaks, no commit.
# Inline "gitleaks:allow" comments are ignored. Exceptions go only in
# .gitleaksignore, which only the owner edits (see docs/setup-git-hooks.md).
#
# Nothing in the caller's environment can change the scan:
# - First the script re-runs itself under `env -i`, keeping only what Git and Windows need.
#   Inherited shell functions, Git config overrides (GIT_CONFIG_*) and GITLEAKS_* variables
#   are gone. Before that it uses only `case`, `exec` and parameter expansion, which
#   inherited functions can't replace.
# - Only Git for Windows' own folders (under Program Files) are on PATH.
# - The gitleaks binary must match the pinned official build.
# - The scan reads each staged file's raw content from the index, not a diff, so
#   .gitattributes, textconv and big-file settings can't hide anything. The config is
#   always .githooks/gitleaks.toml.
# After a gitleaks upgrade the owner updates the pin in a Critical-tier PR.

case "$1" in
  --clean-env) shift ;;
  *)
    exec /usr/bin/env -i \
      STUDIO_GITLEAKS="$(command -v gitleaks 2>/dev/null)" \
      PATH=/ucrt64/bin:/mingw64/bin:/usr/bin:/bin \
      HOME="$HOME" USERPROFILE="$USERPROFILE" SYSTEMROOT="$SYSTEMROOT" WINDIR="$WINDIR" \
      TEMP="$TEMP" TMP="$TMP" LOCALAPPDATA="$LOCALAPPDATA" APPDATA="$APPDATA" \
      GIT_DIR="$GIT_DIR" GIT_WORK_TREE="$GIT_WORK_TREE" GIT_INDEX_FILE="$GIT_INDEX_FILE" \
      GIT_OBJECT_DIRECTORY="$GIT_OBJECT_DIRECTORY" \
      GIT_ALTERNATE_OBJECT_DIRECTORIES="$GIT_ALTERNATE_OBJECT_DIRECTORIES" \
      /usr/bin/sh "$0" --clean-env "$@"
    ;;
esac

GITLEAKS_VERSION=8.30.1
# SHA-256 of gitleaks.exe in the official gitleaks_8.30.1_windows_x64.zip.
GITLEAKS_SHA256=17157e2ee8b76fc8b1d8bee607a250e34b8a8023c8bc81822d4b5ee4d78fcb7c

hook=${0##*/}

block() {
  echo "$hook: $1" >&2
  exit 1
}

# Variables that were empty in the caller must not be set at all.
for name in GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES; do
  eval "[ -n \"\$$name\" ] || unset $name"
done

case "$STUDIO_GITLEAKS" in
  /*) ;;
  *) block "gitleaks $GITLEAKS_VERSION is not installed, so this commit is blocked. Install it from https://github.com/gitleaks/gitleaks/releases, then commit again." ;;
esac
actual=$(sha256sum "$STUDIO_GITLEAKS" | cut -d' ' -f1)
if [ "$actual" != "$GITLEAKS_SHA256" ]; then
  block "gitleaks at $STUDIO_GITLEAKS doesn't match the pinned official $GITLEAKS_VERSION build, so this commit is blocked. If you upgraded gitleaks, the owner updates the pin (docs/setup-git-hooks.md)."
fi

hooks_dir=$(cd "${0%/*}" && pwd) || block "could not find the hooks folder."
config="$hooks_dir/gitleaks.toml"
[ -f "$config" ] || block "$config is missing, so this commit is blocked."
root=$(git rev-parse --show-toplevel) || block "could not find the repository root."

tmp=$(mktemp -d) || block "could not create a temporary folder."
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/files" || block "could not create a temporary folder."

# Added, copied, modified or type-changed entries in the index, with their blob IDs.
git -c core.quotePath=false --no-replace-objects diff --cached --raw --no-abbrev --no-renames \
  --diff-filter=ACMT > "$tmp/list" || block "could not list the staged files."
[ -s "$tmp/list" ] || exit 0

tab=$(printf '\t')
while IFS= read -r line; do
  path=${line#*"$tab"}
  set -- ${line%%"$tab"*}
  mode=$2
  blob=$4
  case "$path" in
    \"*) block "a staged path has characters the scan can't handle; rename it: $path" ;;
  esac
  [ "$mode" = 160000 ] && continue # a submodule: no content of its own
  case "$path" in
    */*) mkdir -p "$tmp/files/${path%/*}" || block "could not prepare $path for the scan." ;;
  esac
  git --no-replace-objects cat-file blob "$blob" > "$tmp/files/$path" || block "could not read $path from the index."
done < "$tmp/list"

# gitleaks would read a staged .gitleaksignore as exceptions; scan it as plain content instead.
if [ -f "$tmp/files/.gitleaksignore" ]; then
  mv "$tmp/files/.gitleaksignore" "$tmp/files/.gitleaksignore.staged" || block "could not prepare .gitleaksignore for the scan."
fi

cd "$tmp/files" || block "could not open the temporary folder."
if ! "$STUDIO_GITLEAKS" dir . --redact --no-banner --ignore-gitleaks-allow --config "$config" --gitleaks-ignore-path "$root"; then
  echo "$hook: gitleaks reported a possible secret (or failed to run). Commit blocked." >&2
  echo "Stop. Don't edit around it. Report the file, line and gitleaks rule ID to the owner" >&2
  echo "(never the secret value), and wait until the owner says to continue." >&2
  exit 1
fi
