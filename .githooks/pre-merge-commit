#!/bin/sh
# Runs the same gitleaks scan as pre-commit on merge commits.
# Only `exec` and parameter expansion run here, and inherited shell functions can't replace
# either one. `sh -p` ignores SHELLOPTS and similar startup variables, and pre-commit then
# cleans the environment before it does anything else. (Limit: see pre-commit.)

exec /usr/bin/sh -p "${0%/*}/pre-commit" "$@"
